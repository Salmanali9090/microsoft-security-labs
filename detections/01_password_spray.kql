// Name: Password spray from a single IP (Entra ID sign-ins)
// Description: One IP failing against many distinct accounts inside a fixed 10-minute bin.
// MITRE: T1110.003 (Brute Force: Password Spraying)
// Tables: SigninLogs
// Status: SIMULATED - logic verified offline on synthetic data; NOT run in a live Microsoft Sentinel tenant
// Assumptions: Entra ID sign-in logs are routed to a Log Analytics workspace; ResultType 50126 = invalid username or password.
// Limitations: Fixed time bins can split an attack across two bins; shared NAT/egress IPs can cause false positives.
// Tuning: raise thresholds for large egress IPs; allowlist known scanners.
let timeWindow = 10m;
let minDistinctUsers = 8;
let minFailures = 10;
SigninLogs
| where TimeGenerated > ago(1d)
| where ResultType == "50126"
| summarize FailedAttempts = count(),
            DistinctUsers = dcount(UserPrincipalName),
            Users = make_set(UserPrincipalName, 50),
            FirstSeen = min(TimeGenerated),
            LastSeen = max(TimeGenerated)
    by IPAddress, WindowStart = bin(TimeGenerated, timeWindow)
| where DistinctUsers >= minDistinctUsers and FailedAttempts >= minFailures
| order by FailedAttempts desc
