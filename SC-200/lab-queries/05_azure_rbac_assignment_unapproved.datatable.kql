// Name: Azure RBAC role assignment by an unapproved caller
// Description: Successful role-assignment writes made by identities not on an approved list.
// MITRE: T1098.003 (Account Manipulation: Additional Cloud Roles)
// Tables: AzureActivity
// Status: SIMULATED - logic verified offline on synthetic data; NOT run in a live tenant
// Assumptions: Azure Activity logs are connected to the workspace; operation name MICROSOFT.AUTHORIZATION/ROLEASSIGNMENTS/WRITE.
// Limitations: ActivityStatusValue wording can differ by log version - both "Success" and "Succeeded" are accepted here; confirm in your data.
// Tuning: replace approvedCallers with your real change-management identities (never commit real names to a public repo).
let AzureActivity = datatable(TimeGenerated:datetime, OperationNameValue:string, ActivityStatusValue:string, Caller:string, CallerIpAddress:string, ResourceGroup:string, ResourceProviderValue:string) [
    datetime(2026-01-10T07:50:00Z), "MICROSOFT.AUTHORIZATION/ROLEASSIGNMENTS/WRITE", "Success", "it.admin@contoso.example", "192.0.2.50", "rg-lab-prod", "MICROSOFT.AUTHORIZATION",
    datetime(2026-01-10T09:50:00Z), "MICROSOFT.AUTHORIZATION/ROLEASSIGNMENTS/WRITE", "Success", "alice@contoso.example", "203.0.113.10", "rg-lab-prod", "MICROSOFT.AUTHORIZATION",
    datetime(2026-01-10T09:55:00Z), "MICROSOFT.COGNITIVESERVICES/ACCOUNTS/REGENERATEKEY/ACTION", "Success", "alice@contoso.example", "203.0.113.10", "rg-lab-ai", "MICROSOFT.COGNITIVESERVICES",
    datetime(2026-01-10T10:10:00Z), "MICROSOFT.STORAGE/STORAGEACCOUNTS/LISTKEYS/ACTION", "Success", "it.admin@contoso.example", "192.0.2.50", "rg-lab-prod", "MICROSOFT.STORAGE"
];
let approvedCallers = dynamic(["it.admin@contoso.example"]);
