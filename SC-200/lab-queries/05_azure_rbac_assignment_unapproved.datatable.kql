| where OperationNameValue =~ "MICROSOFT.AUTHORIZATION/ROLEASSIGNMENTS/WRITE"
| where ActivityStatusValue in~ ("Success", "Succeeded")
| where Caller !in~ (approvedCallers)
| project TimeGenerated, Caller, CallerIpAddress, ResourceGroup, OperationNameValue, ActivityStatusValue
