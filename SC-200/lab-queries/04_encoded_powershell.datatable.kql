// LEARNER VERSION: runs on embedded SYNTHETIC rows (no ingestion needed). Generated by scripts/build_datatable_queries.py - do not edit by hand.
// Name: PowerShell launched with an encoded command
// Description: Flags -EncodedCommand style launches, common in malware and living-off-the-land activity.
// MITRE: T1059.001 (Command and Scripting Interpreter: PowerShell), T1027 (Obfuscated Files or Information)
// Tables: DeviceProcessEvents
// Status: SIMULATED - regex verified offline on synthetic command lines; NOT run in a live workspace
// Assumptions: Defender XDR data is streamed to Sentinel (TimeGenerated). In Defender XDR Advanced Hunting use Timestamp instead.
// Limitations: Legitimate admin tools also use -EncodedCommand; attackers can shorten or reorder switches in ways this regex misses.
// Tuning: exclude known management tooling by InitiatingProcessFileName; decode the payload during triage.
let DeviceProcessEvents = datatable(TimeGenerated:datetime, DeviceName:string, AccountName:string, FileName:string, ProcessCommandLine:string, InitiatingProcessFileName:string) [
    datetime(2026-01-10T08:30:00Z), "SYN-WKS-014", "alice", "powershell.exe", "powershell.exe -File C:\\Scripts\\backup.ps1", "taskeng.exe",
    datetime(2026-01-10T09:00:00Z), "SYN-WKS-021", "carol", "pwsh.exe", "pwsh.exe -Command Get-Process", "explorer.exe",
    datetime(2026-01-10T09:42:00Z), "SYN-WKS-014", "alice", "powershell.exe", "powershell.exe -NoP -W Hidden -enc VwByAGkAdABlAC0ATwB1AHQAcAB1AHQAIAAnAHMAeQBuAHQAaABlAHQAaQBjAC0AbABhAGIALQBwAGEAeQBsAG8AYQBkAC0AYgBlAG4AaQBnAG4AJwA=", "winword.exe",
    datetime(2026-01-10T09:43:00Z), "SYN-WKS-014", "alice", "notepad.exe", "notepad.exe notes.txt", "explorer.exe"
];
DeviceProcessEvents
| where FileName in~ ("powershell.exe", "pwsh.exe")
| where ProcessCommandLine matches regex @"(?i)\s-(e|ec|enc|encodedcommand)\s+[A-Za-z0-9+/=]{20,}"
| project TimeGenerated, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName
