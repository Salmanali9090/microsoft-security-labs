// LEARNER VERSION: runs on embedded SYNTHETIC rows (no ingestion needed). Generated by scripts/build_datatable_queries.py - do not edit by hand.
// Name: Privileged Microsoft Entra role assignment
// Description: Surfaces assignments of high-privilege directory roles for analyst review.
// MITRE: T1098.003 (Account Manipulation: Additional Cloud Roles)
// Tables: AuditLogs
// Status: SIMULATED - logic verified offline on synthetic data shaped like AuditLogs; NOT run in a live tenant
// Assumptions: Operation names "Add member to role" / "Add eligible member to role"; role name in modifiedProperties as Role.DisplayName.
// Limitations: Real PIM activity can use other OperationName values - check your own AuditLogs before relying on this rule.
// Tuning: extend privRoles; join to your change-ticket data to separate approved from unapproved changes.
let AuditLogs = datatable(TimeGenerated:datetime, OperationName:string, InitiatedBy:dynamic, TargetResources:dynamic, CorrelationId:string) [
    datetime(2026-01-10T07:30:00Z), "Add member to role", dynamic({"user": {"userPrincipalName": "it.admin@contoso.example"}}), dynamic([{"userPrincipalName": "helpdesk.user@contoso.example", "modifiedProperties": [{"displayName": "Role.DisplayName", "oldValue": "[]", "newValue": "\"Security Administrator\""}]}]), "11111111-0000-0000-0000-000000000001",
    datetime(2026-01-10T07:45:00Z), "Add member to role", dynamic({"user": {"userPrincipalName": "it.admin@contoso.example"}}), dynamic([{"userPrincipalName": "helpdesk.user@contoso.example", "modifiedProperties": [{"displayName": "Role.DisplayName", "oldValue": "[]", "newValue": "\"Helpdesk Administrator\""}]}]), "11111111-0000-0000-0000-000000000002",
    datetime(2026-01-10T09:35:00Z), "Add member to role", dynamic({"user": {"userPrincipalName": "alice@contoso.example"}}), dynamic([{"userPrincipalName": "svc-backup@contoso.example", "modifiedProperties": [{"displayName": "Role.DisplayName", "oldValue": "[]", "newValue": "\"Global Administrator\""}]}]), "11111111-0000-0000-0000-000000000003",
    datetime(2026-01-10T09:36:00Z), "Update user", dynamic({"user": {"userPrincipalName": "alice@contoso.example"}}), dynamic([{"userPrincipalName": "svc-backup@contoso.example", "modifiedProperties": []}]), "11111111-0000-0000-0000-000000000004"
];
let privRoles = dynamic(["Global Administrator","Privileged Role Administrator","Security Administrator","Exchange Administrator"]);
AuditLogs
| where OperationName in ("Add member to role", "Add eligible member to role")
| extend Actor = tostring(InitiatedBy.user.userPrincipalName),
         Target = tostring(TargetResources[0].userPrincipalName)
| mv-expand prop = TargetResources[0].modifiedProperties
| where tostring(prop.displayName) == "Role.DisplayName"
| extend RoleName = trim('"', tostring(prop.newValue))
| where RoleName in (privRoles)
| project TimeGenerated, OperationName, Actor, Target, RoleName, CorrelationId
