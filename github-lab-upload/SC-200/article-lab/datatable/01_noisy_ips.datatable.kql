// LEARNER VERSION: runs on embedded SYNTHETIC rows (no ingestion needed). Generated by scripts/build_datatable_queries.py - do not edit by hand.
// Name: Noisy source IPs in Entra ID sign-ins (investigation triage)
// Description: Summarises sign-in activity per source IP and keeps IPs with many failed attempts, so an analyst can see scale, spread across accounts and whether any attempt succeeded.
// MITRE: T1110.003 (Password Spraying) - supported only if DistinctUsers is high and attempts per user are low
// Tables: SigninLogs
// Status: SIMULATED - logic verified offline on synthetic data; NOT run in a live Microsoft Sentinel workspace
// Assumptions: Microsoft Entra ID sign-in logs are sent to a Log Analytics workspace; ResultType "50126" = invalid username or password, "0" = success.
// Limitations: Cannot prove who is behind the IP, cannot tell a spray from a shared NAT address by itself, and ignores sign-ins that were blocked before they were logged.
let SigninLogs = datatable(TimeGenerated:datetime, UserPrincipalName:string, IPAddress:string, ResultType:string, AppDisplayName:string) [
    datetime(2026-01-10T07:10:00Z), "carol@contoso.example", "192.0.2.50", "0", "Office 365",
    datetime(2026-01-10T07:11:00Z), "dave@contoso.example", "192.0.2.50", "0", "Office 365",
    datetime(2026-01-10T07:12:00Z), "erin@contoso.example", "192.0.2.50", "0", "Office 365",
    datetime(2026-01-10T07:13:00Z), "frank@contoso.example", "192.0.2.50", "0", "Office 365",
    datetime(2026-01-10T08:00:10Z), "user00@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T08:01:11Z), "user01@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T08:02:12Z), "user02@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T08:03:13Z), "user03@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T08:04:14Z), "user04@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T08:00:15Z), "user05@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T08:01:10Z), "user06@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T08:02:11Z), "user07@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T08:03:12Z), "user08@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T08:04:13Z), "user09@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T08:00:14Z), "user10@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T08:01:15Z), "user11@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T08:05:40Z), "user00@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T08:06:41Z), "user01@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T08:07:42Z), "user02@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T08:08:43Z), "user03@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T09:10:00Z), "alice@contoso.example", "203.0.113.10", "50126", "Office 365",
    datetime(2026-01-10T09:11:00Z), "alice@contoso.example", "203.0.113.10", "50126", "Office 365",
    datetime(2026-01-10T09:12:00Z), "alice@contoso.example", "203.0.113.10", "50126", "Office 365",
    datetime(2026-01-10T09:13:00Z), "alice@contoso.example", "203.0.113.10", "50126", "Office 365",
    datetime(2026-01-10T09:14:00Z), "alice@contoso.example", "203.0.113.10", "50126", "Office 365",
    datetime(2026-01-10T09:15:00Z), "alice@contoso.example", "203.0.113.10", "50126", "Office 365",
    datetime(2026-01-10T09:20:00Z), "alice@contoso.example", "203.0.113.10", "0", "Office 365",
    datetime(2026-01-10T10:00:00Z), "bob@contoso.example", "192.0.2.20", "50126", "Office 365",
    datetime(2026-01-10T10:01:00Z), "bob@contoso.example", "192.0.2.20", "50126", "Office 365",
    datetime(2026-01-10T10:02:00Z), "bob@contoso.example", "192.0.2.20", "0", "Office 365"
];
let minFailures = 5;
SigninLogs
| summarize Attempts = count(),
            Failures = countif(ResultType == "50126"),
            Successes = countif(ResultType == "0"),
            DistinctUsers = dcount(UserPrincipalName),
            FirstSeen = min(TimeGenerated),
            LastSeen = max(TimeGenerated)
    by IPAddress
| where Failures >= minFailures
| order by Failures desc
