    datetime(2026-01-10T08:04:14Z), "user04@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T08:00:15Z), "user05@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T08:01:10Z), "user06@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T08:02:11Z), "user07@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T08:03:12Z), "user08@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T08:04:13Z), "user09@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T08:00:14Z), "user10@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T08:01:15Z), "user11@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T08:05:40Z), "user00@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T08:06:41Z), "user01@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T08:07:42Z), "user02@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T08:08:43Z), "user03@contoso.example", "203.0.113.10", "50126", "Azure Portal",
    datetime(2026-01-10T09:10:00Z), "alice@contoso.example", "203.0.113.10", "50126", "Office 365",
    datetime(2026-01-10T09:11:00Z), "alice@contoso.example", "203.0.113.10", "50126", "Office 365",
    datetime(2026-01-10T09:12:00Z), "alice@contoso.example", "203.0.113.10", "50126", "Office 365",
    datetime(2026-01-10T09:13:00Z), "alice@contoso.example", "203.0.113.10", "50126", "Office 365",
    datetime(2026-01-10T09:14:00Z), "alice@contoso.example", "203.0.113.10", "50126", "Office 365",
    datetime(2026-01-10T09:15:00Z), "alice@contoso.example", "203.0.113.10", "50126", "Office 365",
    datetime(2026-01-10T09:20:00Z), "alice@contoso.example", "203.0.113.10", "0", "Office 365",
    datetime(2026-01-10T10:00:00Z), "bob@contoso.example", "192.0.2.20", "50126", "Office 365",
    datetime(2026-01-10T10:01:00Z), "bob@contoso.example", "192.0.2.20", "50126", "Office 365",
    datetime(2026-01-10T10:02:00Z), "bob@contoso.example", "192.0.2.20", "0", "Office 365"
];
let suspectUser = "alice@contoso.example";
SigninLogs
| where UserPrincipalName == suspectUser
| project TimeGenerated, IPAddress, AppDisplayName, ResultType,
          Outcome = iff(ResultType == "0", "Success", "Failure")
| order by TimeGenerated asc
